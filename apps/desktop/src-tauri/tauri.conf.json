{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forma",
  "version": "0.1.0",
  "identifier": "com.forma.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @forma/web",
    "beforeBuildCommand": "npm run prebuild:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Forma",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/forma-server"]
  }
}
