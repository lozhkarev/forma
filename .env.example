# Forma configuration. Copy to `.env` (gitignored) and fill in what you need.
# Everything here is optional if you run inside Claude Code: the server falls
# back to credentials in ~/.claude/settings.json automatically.

# --- Agent credentials (pick ONE) ---
# Anthropic API key:
# ANTHROPIC_API_KEY=sk-ant-...
#
# …or a gateway: base URL + bearer token:
# ANTHROPIC_BASE_URL=https://api.example.com/anthropic
# ANTHROPIC_AUTH_TOKEN=...

# --- Optional ---
# FORMA_VAULT=./vault
# FORMA_PORT=8787
# FORMA_AGENT_MODEL=claude-sonnet-4-6
# FORMA_MAX_CONCURRENT=2
